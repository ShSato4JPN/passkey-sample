# ===== WebAuthn (Passkey) 設定 =====
# RP (Relying Party) = あなたのサービス。

# RP の表示名（ユーザーの認証ダイアログに表示される）
RP_NAME="Passkey Sample"

# RP ID = パスキーをスコープするドメイン。
# 重要:
#   - スキーム(https://)やポートを含めない。ホスト名のみ。
#   - localhost 開発時は "localhost"。
#   - 本番では "example.com"（サブドメイン全体で使うなら登録ドメインを指定）。
#   - origin の「登録可能なサフィックス」である必要がある。
RP_ID="localhost"

# 期待する Origin（スキーム・ホスト・ポートを完全一致で検証する）。
# 複数 Origin を許可する場合はカンマ区切り。
EXPECTED_ORIGIN="http://localhost:3000"

# ===== データベース (Prisma + PostgreSQL) =====
# Vercel では Marketplace 連携(Neon Postgres 等)で DATABASE_URL が自動注入される。
# `vercel env pull` でローカルへ取得可能。
# ローカルで自前 Postgres を使う場合の例:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/passkey?schema=public"

# Neon 等プーリング有りの場合、マイグレーション用に直結URLを併用することがある:
# DIRECT_URL="postgresql://...@...neon.tech/db?sslmode=require"

# ===== Cron =====
# 期限切れ challenge 掃除エンドポイントの保護用シークレット。
#   - ローカル: docker-compose の cron コンテナがこの値で叩く
#   - 本番(Vercel): 同名で環境変数を設定すると Vercel Cron が自動付与
CRON_SECRET="dev-cron-secret"
# cron 間隔(任意。既定 */5 * * * *)・宛先URL(任意)を上書きしたい場合:
# CRON_SCHEDULE="*/5 * * * *"
# CRON_TARGET_URL="http://host.docker.internal:3000/api/cron/cleanup-challenges"
